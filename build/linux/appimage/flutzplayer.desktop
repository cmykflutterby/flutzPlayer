[Desktop Entry]
Type=Application
Name=flutzPlayer
Comment=Audio player
Exec=flutzplayer --gui %f
Icon=flutzplayer
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/midi;audio/x-midi;audio/mpeg;audio/ogg;audio/opus;audio/flac;audio/wav;audio/x-wav;audio/aac;audio/mp3;audio/mp4;
StartupNotify=true
