#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: flutzplayer-base
    username: vagrant
    # Standard disposable Vagrant development password hash; SSH password login is disabled.
    password: "$6$flutzbox$uq6.tpWVUJCyM6ngpXRIiglQ2F3wDBXPuZ5LajWkUk6qtDZhRxMRYL4h4aFnuArWSavY8XFxM8c68rKhvQGe.."
  ssh:
    install-server: true
    # Enabled only for the NAT-isolated Packer install; provisioning disables it before packaging.
    allow-pw: true
    authorized-keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIN1YdxBpNlzxDqfJyw/QKow1F+wvG9hXGoqiysfJOn5Y vagrant insecure public key
      - ssh-rsa  vagrant insecure public key
  storage:
    layout:
      name: direct
  packages:
    - openssh-server
    - virtualbox-guest-utils
    - virtualbox-guest-x11
  late-commands:
    - curtin in-target --target=/target -- systemctl enable ssh
    - curtin in-target --target=/target -- sh -c "echo 'vagrant ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/99-vagrant"
    - curtin in-target --target=/target -- chmod 0440 /etc/sudoers.d/99-vagrant
  shutdown: reboot
