{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flutzplayer.local/schemas/linux-provisioning-manifest/v1",
  "title": "flutzPlayer Linux build VM provisioning manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "ubuntu",
    "rust",
    "requiredChecks",
    "desktop",
    "appImageTools",
    "provisionedAtUtc"
  ],
  "properties": {
    "schemaId": {
      "const": "https://flutzplayer.local/schemas/linux-provisioning-manifest/v1"
    },
    "ubuntu": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "release", "architecture" ],
      "properties": {
        "release": { "const": "26.04.1" },
        "architecture": { "const": "x86_64" }
      }
    },
    "rust": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "rustupToolchain", "rustcVersion", "cargoVersion" ],
      "properties": {
        "rustupToolchain": { "type": "string", "minLength": 1 },
        "rustcVersion": { "type": "string", "minLength": 1 },
        "cargoVersion": { "type": "string", "minLength": 1 }
      }
    },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "name", "status", "identity" ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "const": "working" },
          "identity": { "type": "string", "minLength": 1 }
        }
      }
    },
    "desktop": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "gnome", "gnomeRemoteDesktop", "remoteDesktopServiceEnabled", "remoteDesktopServiceActive", "sessionType" ],
      "properties": {
        "gnome": { "type": "string", "minLength": 1 },
        "gnomeRemoteDesktop": { "type": "string", "minLength": 1 },
        "remoteDesktopServiceEnabled": { "const": true },
        "remoteDesktopServiceActive": { "const": true },
        "sessionType": { "const": "wayland" }
      }
    },
    "appImageTools": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "linuxdeploy", "appimagetool" ],
      "properties": {
        "linuxdeploy": { "$ref": "#/$defs/pinnedTool" },
        "appimagetool": { "$ref": "#/$defs/pinnedTool" }
      }
    },
    "provisionedAtUtc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "pinnedTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "release", "asset", "sha256" ],
      "properties": {
        "release": { "type": "string", "minLength": 1 },
        "asset": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
