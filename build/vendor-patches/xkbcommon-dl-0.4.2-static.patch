 use once_cell::sync::OnceCell;
 
+// flutzPlayer patch: with the `static` feature, each library struct keeps the same
+// public function-pointer fields but is filled from symbols linked into the binary,
+// so no libxkbcommon*.so is loaded at runtime.
+macro_rules! xkb_external_library {
+    ($structname:ident, functions: $(fn $fname:ident($($farg:ty),*) -> $fret:ty),+ $(,)?) => {
+        #[cfg(not(feature = "static"))]
+        dlopen_external_library!($structname,
+        functions: $(fn $fname($($farg),*) -> $fret),+,
+        );
+
+        #[cfg(feature = "static")]
+        #[allow(improper_ctypes_definitions)]
+        pub struct $structname {
+            $(pub $fname: unsafe extern "C" fn($($farg),*) -> $fret,)+
+        }
+
+        #[cfg(feature = "static")]
+        impl $structname {
+            fn linked() -> Self {
+                // Opaque xkb_* handle types are zero-sized structs only ever used behind pointers.
+                #[allow(improper_ctypes)]
+                extern "C" {
+                    $(fn $fname($(_: $farg),*) -> $fret;)+
+                }
+                Self { $($fname,)+ }
+            }
+        }
+    };
+}
