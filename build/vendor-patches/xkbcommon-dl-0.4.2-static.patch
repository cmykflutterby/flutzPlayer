+use std::env;
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::process::Command;
+
+fn main() {
+    println!("cargo:rerun-if-changed=build.rs");
+    if env::var_os("CARGO_FEATURE_STATIC").is_none() {
+        return;
+    }
+    if env::var("CARGO_CFG_TARGET_OS").as_deref() != Ok("linux") {
+        panic!("xkbcommon-dl: the `static` feature is only supported on Linux targets");
+    }
+
+    let manifest_dir = PathBuf::from(env::var("CARGO_MANIFEST_DIR").unwrap());
+    let source_dir = manifest_dir.join("libxkbcommon");
+    for watched in ["meson.build", "meson_options.txt", "src", "include"] {
+        println!("cargo:rerun-if-changed={}", source_dir.join(watched).display());
+    }
+    println!("cargo:rerun-if-env-changed=PKG_CONFIG_PATH");
+
+    let out_dir = PathBuf::from(env::var("OUT_DIR").unwrap());
+    let build_dir = out_dir.join("libxkbcommon-build");
+    let lib_dir = out_dir.join("lib");
+    let with_x11 = env::var_os("CARGO_FEATURE_X11").is_some();
+
+    if build_dir.exists() {
+        fs::remove_dir_all(&build_dir).expect("failed to clear libxkbcommon build directory");
+    }
+    fs::create_dir_all(&lib_dir).expect("failed to create static library directory");
+
+    // Runtime data lookups (keymaps by RMLVO names, Compose tables) keep using the
+    // distribution-standard locations; X11 and Wayland keymaps come from the server.
+    let mut setup = Command::new("meson");
+    setup
+        .arg("setup")
+        .arg(&build_dir)
+        .arg(&source_dir)
+        .args([
+            "--buildtype=release",
+            "--prefix=/usr",
+            "--sysconfdir=/etc",
+            "--datadir=share",
+            "-Ddefault_library=static",
+            "-Db_staticpic=true",
+            "-Denable-tools=false",
+            "-Denable-docs=false",
+            "-Denable-wayland=false",
+            "-Denable-xkbregistry=false",
+            "-Denable-bash-completion=false",
+            "-Dxkb-config-root=/usr/share/X11/xkb",
+            "-Dxkb-config-extra-path=/etc/xkb",
+            "-Dx-locale-root=/usr/share/X11/locale",
+        ])
+        .arg(format!("-Denable-x11={with_x11}"));
+    run(&mut setup, "meson setup");
+
+    let mut compile = Command::new("meson");
+    compile.arg("compile").arg("-C").arg(&build_dir);
+    if let Ok(jobs) = env::var("NUM_JOBS") {
+        compile.arg("-j").arg(jobs);
+    }
+    compile.arg("xkbcommon");
+    if with_x11 {
+        compile.arg("xkbcommon-x11");
+    }
+    run(&mut compile, "meson compile");
+
+    copy_archive(&build_dir.join("libxkbcommon.a"), &lib_dir);
+    if with_x11 {
+        copy_archive(&build_dir.join("libxkbcommon-x11.a"), &lib_dir);
+        let xcb_libdir = pkg_config_libdir("xcb-xkb");
+        copy_archive(&xcb_libdir.join("libxcb-xkb.a"), &lib_dir);
+    }
+
+    println!("cargo:rustc-link-search=native={}", lib_dir.display());
+    if with_x11 {
+        println!("cargo:rustc-link-lib=static=xkbcommon-x11");
+    }
+    println!("cargo:rustc-link-lib=static=xkbcommon");
+    if with_x11 {
+        println!("cargo:rustc-link-lib=static=xcb-xkb");
+        // Shared with libX11/winit so the X connection object has one owner.
+        println!("cargo:rustc-link-lib=dylib=xcb");
+    }
+}
+
+fn run(command: &mut Command, what: &str) {
+    let status = command
+        .status()
+        .unwrap_or_else(|error| panic!("xkbcommon-dl: failed to run {what}: {error} (is meson installed?)"));
+    if !status.success() {
+        panic!("xkbcommon-dl: {what} failed with {status}");
+    }
+}
+
+fn copy_archive(source: &Path, lib_dir: &Path) {
+    let destination = lib_dir.join(source.file_name().unwrap());
+    fs::copy(source, &destination).unwrap_or_else(|error| {
+        panic!("xkbcommon-dl: failed to copy {}: {error}", source.display())
+    });
+}
+
+fn pkg_config_libdir(package: &str) -> PathBuf {
+    let output = Command::new("pkg-config")
+        .args(["--variable=libdir", package])
+        .output()
+        .unwrap_or_else(|error| panic!("xkbcommon-dl: failed to run pkg-config: {error}"));
+    let libdir = String::from_utf8_lossy(&output.stdout).trim().to_owned();
+    if !output.status.success() || libdir.is_empty() {
+        panic!("xkbcommon-dl: pkg-config could not locate {package}; install its development package");
+    }
+    PathBuf::from(libdir)
+}
